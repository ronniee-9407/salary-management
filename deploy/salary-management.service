[Unit]
Description=FastAPI Salary Management Backend Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/var/www/salary-management/backend
ExecStart=/var/www/salary-management/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4
Restart=always
RestartSec=3
Environment="PYTHONPATH=/var/www/salary-management/backend"

[Install]
WantedBy=multi-user.target
